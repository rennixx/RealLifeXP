{
  "name": "reallife-xp",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "format": "prettier \"**/*.{js,jsx,ts,tsx,json,md}\" --write",
    "format:check": "prettier \"**/*.{js,jsx,ts,tsx,json,md}\" --check",
    "supabase:init": "npx supabase init --workdir .",
    "supabase:start": "npx supabase start",
    "supabase:reset": "npx supabase db reset",
    "supabase:types": "npx supabase gen types typescript --local > src/types/database.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.55.0",
    "@tanstack/react-query": "^5.74.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.7",
    "expo-crypto": "~15.0.2",
    "expo-font": "~14.0.0",
    "expo-haptics": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0-beta.0",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-web-browser": "~15.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.59.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-view-shot": "4.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.15",
    "prettier": "^3.5.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  }
}
